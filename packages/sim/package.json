{
  "name": "@chao-draft/sim",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript simulation core for Chao Draft — cards, bonding, chao stats. No DOM, no React, no Math.random().",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
